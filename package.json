{
  "name": "doing-list",
  "version": "0.1.2",
  "description": "Doing List — 个人学习生活记录",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoyang-1607/doing-list.git"
  },
  "homepage": "https://github.com/xiaoyang-1607/doing-list#readme",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "release": "electron-vite build && electron-builder --publish always",
    "build:vite": "electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test src/main/validation.test.ts src/shared/diaryExcerpt.test.ts",
    "check": "npm run typecheck && npm test && npm run build:vite",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps",
    "install:safe": "npm install --ignore-scripts && node node_modules/electron/install.js && npm run postinstall",
    "sync:github": "node scripts/git-sync.mjs",
    "readme:publish": "node scripts/readme-publish.mjs",
    "cleanup:installers": "node scripts/cleanup-installers.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "electron-updater": "6.8.9",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "build": {
    "appId": "com.doinglist.app",
    "productName": "Doing List",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xiaoyang-1607",
        "repo": "doing-list",
        "releaseType": "release"
      }
    ]
  }
}
